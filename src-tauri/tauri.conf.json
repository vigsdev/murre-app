{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murre",
  "version": "0.2.0",
  "identifier": "com.vigs.murre",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Murre",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24.5 },
        "transparent": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "companion-bundle/": "companion/" },
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRTBFMjVDRUNGNzA4Q0MKUldUTUNQZnNYT0xnWHpDdkNKWnZ1YVR0UlJWblJRcG9qS3kzZHcvMzZNWGZQYzFjV1ZndjhKenUK",
      "endpoints": ["https://github.com/vigsdev/murre-app/releases/latest/download/latest.json"]
    }
  }
}
